# Copy to .env and adjust. Euler.SC reads these from the process environment;
# it does NOT load a .env file by itself. Use your shell, or
#   set -a; . ./.env; set +a      (macOS / Linux)
# Nothing here is a secret: the application has no credentials to store.

# --- Diagnostics -------------------------------------------------------------
# "1" enables right-click menus, DevTools and verbose logging in the window.
# Default: off. Never ship a build with this on.
EULER_DEBUG=0

# "1" serves the interface on loopback without opening a native window, and
# prints the URL. Useful for browser-based UI checks. Default: off.
EULER_SERVE_ONLY=0

# --- Local model storage -----------------------------------------------------
# Directory where Ollama keeps downloaded models. Empty = Ollama's default.
# Also settable in the app: Settings -> Models folder.
OLLAMA_MODELS=

# --- Platform data location (read by the OS-specific settings code) ----------
# Windows: %APPDATA%\EulerSC\ is used; these two are only read as fallbacks.
# Linux:   $XDG_DATA_HOME/EulerSC/ (default ~/.local/share/EulerSC/)
XDG_DATA_HOME=
