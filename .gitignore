# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# PyInstaller: generated work directory. build/euler.spec and the build
# scripts stay tracked; everything PyInstaller writes next to them does not.
build/euler/
build/pyinstaller/
build/*.toc
build/*.pkg
build/*.pyz
build/*.zip
build/*.html
build/warn-*.txt
dist/
*.spec.bak

# Installer artefacts
*.exe
*.msi

# Release archives are published as GitHub releases, never committed
EulerSC-*.zip

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Scratch files from debugging; never part of a build
_*.png
_*.jpg

# Local data
logs/
exports/
settings.json
.env
.env.local
.ruff_cache/

node_modules/
